# Environment variables for Ethereum deployment

# Network RPC URLs (get from Infura, Alchemy, or other providers)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Private key for deployment (NEVER commit this to git!)
# Generate a new wallet for testing: https://vanity-eth.tk/
PRIVATE_KEY=your_private_key_here

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Enable gas reporting
REPORT_GAS=true
