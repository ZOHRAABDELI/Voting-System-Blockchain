# Ethereum Network Configuration
# Use Sepolia testnet for development (free test ETH available)
WEB3_PROVIDER_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# Contract Address (will be set after deployment)
CONTRACT_ADDRESS=0x

# Private Key for contract owner/deployer (from MetaMask)
# WARNING: Never commit this to version control!
# Get test ETH from: https://www.sepolia.dev/#faucet
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
