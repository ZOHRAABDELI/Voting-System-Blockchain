# Ethereum Network Configuration

# Ethereum Node Connection
ETH_PROVIDER_URL=http://127.0.0.1:8545
ETH_CHAIN_ID=31337

# Deployed Contract Address (set after deployment)
CONTRACT_ADDRESS=

# Contract ABI Path
ABI_PATH=contracts/solidity/deployments/VotingSystem.abi.json

# Default Private Key for Transactions (DEVELOPMENT ONLY!)
# DO NOT use this in production! Each user should have their own private key
DEFAULT_PRIVATE_KEY=

# Flask Configuration
PORT=5000
DEBUG=True

# Network Options (uncomment for different networks):

# Sepolia Testnet
# ETH_PROVIDER_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# ETH_CHAIN_ID=11155111

# Ethereum Mainnet (PRODUCTION - USE WITH CAUTION!)
